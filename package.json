{
  "name": "express-api-ecommerce",
  "version": "0.0.1",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "hash:password": "node scripts/hash-password.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "prisma": "node --env-file=.env node_modules/prisma/build/index.js",
    "prisma:studio": "node --env-file=.env node_modules/prisma/build/index.js studio"
  },
  "keywords": [
    "node",
    "express",
    "ecommerce"
  ],
  "author": "Luis Larghi",
  "license": "ISC",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/preset-typescript": "7.27.1",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2"
  },
  "jest": {
    "verbose": true,
    "silent": true,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "setupFiles": [
      "./.jest/setEnvVars.js"
    ]
  }
}